# Дампы с устройства: токен привязки аккаунта, логин/пароль TorrServer,
# содержимое экрана. Репозиторий публичный — эти файлы остаются только на диске.
# Конвенция и обоснование: docs/snapshots-convention.md.
#
# Первая строка закрывает штатный путь, остальные — тот же материал, случайно
# оказавшийся вне snapshots/ (выгрузка в корень, скриншот рядом с доком).
snapshots/
settings.xml
*.ldb
*.log
leveldb/
MANIFEST-*
*.png
*.jpg
*.jpeg

# Зеркало старой локальной истории, если оно окажется внутри проекта.
_archive/

# Локальное окружение и кеши инструментов
.venv/
__pycache__/
.ruff_cache/
.mypy_cache/
.idea/

# Локальные разрешения агента — машинное, не проектное
.claude/settings.local.json

# Креды в рабочем дереве
.env
.env.*
!.env.example
*.session

Thumbs.db
.DS_Store
*.tmp
