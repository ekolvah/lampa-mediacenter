{
  "permissions": {
    "deny": [
      "Bash(git remote add:*)",
      "Bash(git remote set-url:*)",
      "Bash(git config remote.:*)",
      "Bash(gh repo create:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(git branch -D:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(adb uninstall:*)",
      "Bash(adb shell pm uninstall:*)",
      "Bash(adb shell pm clear:*)",
      "Bash(adb shell rm:*)",
      "Bash(adb shell su -c rm:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/claude_hook.py",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/agent-process-check.py\" https://github.com/ekolvah/agent-process-distribution/blob/v3.28.0/skills/agent-process/SKILL.md#install"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "agent-process-marketplace": {
      "source": {
        "source": "github",
        "repo": "ekolvah/agent-process-distribution",
        "ref": "stable"
      },
      "autoUpdate": true
    }
  }
}
