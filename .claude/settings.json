{
  "permissions": {
    "deny": [
      "Bash(git remote add:*)",
      "Bash(git remote set-url:*)",
      "Bash(git config remote.:*)",
      "Bash(gh repo create:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(git branch -D:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(adb uninstall:*)",
      "Bash(adb shell pm uninstall:*)",
      "Bash(adb shell pm clear:*)",
      "Bash(adb shell rm:*)",
      "Bash(adb shell su -c rm:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/claude_hook.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
